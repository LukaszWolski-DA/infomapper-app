# Copy to .env.local and fill in. Never commit .env.local.
# Slice 0 runs on the local JSON-file adapter and development sign-in (AD-29) and needs no variables yet.
# Every variable the application reads must be listed here, without its value.

# Path of the local data file (optional, default .data/dev-db.json). Used by tests.
INFOMAPPER_DEV_DB=

# Port for the dev server started by `npm run e2e` (optional, default 3200).
E2E_PORT=
