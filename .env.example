# Copy to .env.local and fill in. Never commit .env.local.
# The local JSON-file adapter and the development sign-in (AD-29) need no variables.
# Every variable the application reads must be listed here, without its value.

# Path of the local data file (optional, default .data/dev-db.json). Used by tests.
INFOMAPPER_DEV_DB=

# Signs development session cookies (slice 8; at least 32 characters, optional). Without it the server makes
# .data/session-secret (git-ignored) once. Never log it.
INFOMAPPER_SESSION_SECRET=

# 1: the canvas page's test hooks (slice 4p). Set only by the e2e dev server; never in a normal build.
INFOMAPPER_TEST_HOOKS=

# Port for the dev server started by `npm run e2e` (optional, default 3200).
E2E_PORT=

# An empty Postgres database for `npm run schema:check` (AD-31; CI sets it). Not used by the application.
DATABASE_URL=

# ---- Slice 29: Postgres. Environment 1 (npm run dev, the local adapter) needs none of these. ----
# Environment 2 keeps them in .env.postgres.local (git-ignored, read only by npm run dev:pg and the Postgres scripts);
# environment 3 in Vercel's Preview environment. Never in .env.local, which Next.js loads for npm run dev.

# "local" (the default) or "postgres": the adapter the server runs on. Set by npm run dev:pg, CI's Postgres jobs and
# Vercel; never in a file.
INFOMAPPER_DATA=

# The app's database: Supabase's transaction pooler (port 6543). The app and npm run pg:check.
INFOMAPPER_DATABASE_URL=

# Migrations, the seed loader and schema:check --existing: Supabase's session pooler (port 5432). Scripts only.
INFOMAPPER_MIGRATION_URL=

# The Supabase project's URL and publishable key (the app's sign-in, step 3).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The secret key: the accounts script only (step 3), never in Vercel.
SUPABASE_SECRET_KEY=

# The demo people's password for their Supabase accounts (development only: the accounts script, the smoke specs).
INFOMAPPER_DEMO_PASSWORD=

# A database on this machine for the contract suite's Postgres side (CI's container). The suite empties it and refuses
# any other host.
INFOMAPPER_CONTRACT_DB=

# The database environment the top bar's server badge names on Postgres (slice 30, Q7): "dev" for infomapper-dev, so
# the badge says "Online · dev"; without it, "Online". A plain value: in .env.postgres.local for npm run dev:pg and in
# Vercel's Preview for dev. The local adapter's badge says "Local" and reads none.
INFOMAPPER_SERVER_NAME=

# 1: the timing record (slice 29, step 4): the app counts each request's reads (Server-Timing on the thumbnail route, a
# hidden record on the homes and the canvas page, a log line for the editor's snapshot). Read by the app; set to 1 in
# Vercel's Preview only, unset everywhere else.
INFOMAPPER_TIMING=

# The preview's Protection Bypass for Automation secret (Vercel). Read by the measuring spec, the smoke set's preview
# mode (playwright.pg.config.ts) and scripts/preview-probe.ts on the laptop; never by the app. It lives only in
# .env.postgres.local: never in .env.local, a commit, CI or a message.
VERCEL_AUTOMATION_BYPASS_SECRET=
