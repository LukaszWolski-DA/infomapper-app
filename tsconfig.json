{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-restart/types/**/*.ts",
    ".next-e2e-restart/dev/types/**/*.ts",
    ".next-measure/types/**/*.ts",
    ".next-measure/dev/types/**/*.ts",
    ".next-e2e-preview/types/**/*.ts",
    ".next-e2e-preview/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "spikes",
    "docs",
    ".next-e2e",
    ".next-e2e-restart",
    ".next-measure"
  ]
}
